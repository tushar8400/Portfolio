# Copy this file to .env and fill in the values
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# Where your React app runs (used for CORS). Comma-separate for multiple.
CLIENT_URL=http://localhost:5173

# Secret key needed to add / edit / delete projects via the API
ADMIN_KEY=change-this-to-a-long-random-string
